[color]
  ui = true

[core]
  editor = nvim
  excludesfile = ~/.gitignore_global
  autocrlf=input
  ; pager = hunk pager
  pager = delta

[rebase]
  updateRefs = true

[alias]
  adog="log --all --decorate --oneline --graph"

[diff]
  tool = nvimdiff
  colorMoved = default

[merge]
  tool = nvimdiff

[difftool]
  prompt = false

[mergetool]
  keepBackup = false
  prompt = true

[include]
  path = ~/.gitconfig-local

[merge]
  conflictstyle = zdiff3

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true    # use n and N to move between diff sections
  line-numbers = true

[difftool "hunk"]
	cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"

[difftool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE" "$MERGED"

[mergetool "nvim-diffview"]
  cmd = nvim -n -c "DiffviewOpen" "$MERGE"

[includeIf "gitdir:~/.config/nvim"]
  path = .gitconfig.submodules

[alias]
    diff-side-by-side = -c delta.features=side-by-side diff

